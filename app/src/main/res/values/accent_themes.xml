<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One overlay for each color of the color wheel, in the wheel's order (Red, Orange, Yellow,
         Lime, Green, Teal, Blue, Purple, Magenta, Pink). Each sets the app's accent to that color,
         made lighter if it had less than 7 to 1 contrast on the dark background; Red and Magenta are
         left as they are. A test checks that these match what AccentColors works out. -->
    <style name="ThemeOverlay.TSched.Accent0" parent="">
        <item name="appAccent">#FFEF5350</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent1" parent="">
        <item name="appAccent">#FFFF8A3D</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent2" parent="">
        <item name="appAccent">#FFFFC93C</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent3" parent="">
        <item name="appAccent">#FFC6E05A</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent4" parent="">
        <item name="appAccent">#FF68BC6C</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent5" parent="">
        <item name="appAccent">#FF2BBDAF</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent6" parent="">
        <item name="appAccent">#FF5AB1F6</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent7" parent="">
        <item name="appAccent">#FFCF96D9</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent8" parent="">
        <item name="appAccent">#FFEC407A</item>
    </style>
    <style name="ThemeOverlay.TSched.Accent9" parent="">
        <item name="appAccent">#FFF48FB1</item>
    </style>
    <!-- The secret choices: Grayscale (white), Beige, Halloween (all orange; its titles shade to yellow in code),
         Christmas (red buttons, green text), and Fruity, which cycles live in code and is plain gray here, where it starts. -->
    <style name="ThemeOverlay.TSched.AccentGrayscale" parent="">
        <item name="appAccent">#FFFFFFFF</item>
        <item name="appAccentText">#FFFFFFFF</item>
        <item name="appAccentOutline">#FFFFFFFF</item>
    </style>
    <style name="ThemeOverlay.TSched.AccentBeige" parent="">
        <item name="appAccent">#FFE8D8B8</item>
        <item name="appAccentText">#FFE8D8B8</item>
        <item name="appAccentOutline">#FFE8D8B8</item>
