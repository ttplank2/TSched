<?xml version="1.0" encoding="utf-8"?>
<!-- A choice button's border: the lighter gray of a text field's underline once something is
     chosen, otherwise the usual outline. Day buttons are "checked", time buttons "selected". -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/text_secondary" android:state_checked="true" />
    <item android:color="@color/text_secondary" android:state_selected="true" />
    <item android:color="?attr/colorOutline" />
</selector>
