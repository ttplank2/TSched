<?xml version="1.0" encoding="utf-8"?>
<!-- The gear button at the right of the top bar; it opens Settings. The frame around it
     keeps the button off the edge of the screen; it sits right against Snap to Day. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="10dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_button"
        style="@style/Widget.TSched.Button.Outlined"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/settings"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_settings_gear"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/text_secondary"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp" />
</FrameLayout>
