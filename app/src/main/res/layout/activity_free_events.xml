<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- The same size and shape as Recall All Events below it, whatever the accent. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/place_events_button"
            style="@style/Widget.TSched.BottomButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_button_height"
            android:layout_marginBottom="8dp"
            android:text="@string/place_events" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recall_all_button"
            style="@style/Widget.TSched.BottomButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_button_height"
            android:layout_marginBottom="12dp"
            android:text="@string/recall_all" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/free_board_hint"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/load_failed"
            android:textColor="?attr/colorError"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="@string/no_free_events"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/free_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
