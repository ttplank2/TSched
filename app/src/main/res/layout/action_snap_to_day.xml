<?xml version="1.0" encoding="utf-8"?>
<!-- The Snap to Day button in the top bar. It is a real button, like Filter, so a press flashes
     white across the whole button instead of as a small circle. -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snap_to_day_button"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="0dp"
    android:paddingHorizontal="8dp"
    android:text="@string/snap_to_day"
    android:textAllCaps="false"
    android:textColor="?attr/appAccentText"
    android:textSize="12sp"
    android:textStyle="bold"
    app:rippleColor="@color/white_flash"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="2dp" />
