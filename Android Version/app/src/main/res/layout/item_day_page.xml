<?xml version="1.0" encoding="utf-8"?>
<!-- One day of the calendar. The card is fully opaque so nothing behind it shows through
     while swiping; side days are darkened by the shade on top instead of being faded. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/charcoal_raised"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/charcoal_line"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/day_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/appAccentText"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/day_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_secondary" />

            <edu.illinois.ttplank2.tsched.DayScrollView
                android:id="@+id/day_scroller"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <edu.illinois.ttplank2.tsched.DayScheduleView
                    android:id="@+id/day_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </edu.illinois.ttplank2.tsched.DayScrollView>
        </LinearLayout>

        <!-- Black shade; MainActivity raises its alpha as the day moves off center. -->
        <View
            android:id="@+id/side_shade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@android:color/black"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
