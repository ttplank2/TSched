<?xml version="1.0" encoding="utf-8"?>
<!-- Sora, the app's font everywhere. sora.ttf is a variable font, so each weight below is
     the same file set to a different 'wght'. Licensed under the SIL Open Font License 1.1.
     Android 8.0-8.1 ignore fontVariationSettings, so there every weight shows as regular Sora;
     that is an acceptable fallback, hence targetApi 28 on each entry. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/sora"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400"
        tools:targetApi="28" />
    <font
        android:font="@font/sora"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500"
        tools:targetApi="28" />
    <font
        android:font="@font/sora"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700"
        tools:targetApi="28" />
</font-family>
